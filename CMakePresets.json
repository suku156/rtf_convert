{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cli",
      "displayName": "CLI Build",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build_cli",
      "cacheVariables": {
        "BUILD_CLI": "ON",
        "BUILD_GUI": "OFF"
      }
    },
    {
      "name": "gui",
      "displayName": "GUI Build",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build_gui",
      "cacheVariables": {
        "BUILD_CLI": "OFF",
        "BUILD_GUI": "ON",
        "CMAKE_PREFIX_PATH":  "C:/Qt/6.10.2/mingw_64",
        "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe"
      }
    },
    {
      "name": "sandbox",
      "displayName": "Sandbox Build",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build_sandbox",
      "cacheVariables": {
        "BUILD_CLI": "OFF",
        "BUILD_GUI": "OFF",
        "BUILD_SANDBOX": "ON"
      } 
    },
    {
     "name": "linux-cli",
     "displayName": "Linux CLI Build",
     "inherits": "cli",
     "generator": "Unix Makefiles",
     "binaryDir": "${sourceDir}/build_linux_cli"
    },
    {
     "name": "linux-gui",
     "displayName": "Linux GUI Build",
     "generator": "Unix Makefiles",
     "binaryDir": "${sourceDir}/build_linux_gui",
     "cacheVariables": {
     "BUILD_CLI": "OFF",
     "BUILD_GUI": "ON",
     "BUILD_SANDBOX": "OFF"
     }
    }
  ],
  "buildPresets": [
    {
      "name": "build-cli",
      "configurePreset": "cli"
    },
    {
      "name": "build-gui",
      "configurePreset": "gui"
    },
    {
      "name": "build-sandbox",
      "configurePreset": "sandbox" 
    },
    {
      "name": "build-linux-cli",
      "configurePreset": "linux-cli"
    },
    {
      "name": "build-linux-gui",
      "configurePreset": "linux-gui"
    }
  ]
}